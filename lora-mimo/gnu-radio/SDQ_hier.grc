    alias: ''
    comment: ''
    label: In
    maxoutbuf: '0'
    minoutbuf: '0'
    num_streams: '1'
    optional: 'False'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [96, 200.0]
    rotation: 0
    state: enabled

connections:
