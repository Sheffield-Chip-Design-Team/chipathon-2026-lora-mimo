  id: pad_sink
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    label: Out_1B
    num_streams: '1'
    optional: 'False'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 200.0]
    rotation: 0
    state: enabled
- name: pad_source_0
  id: pad_source
  parameters:
