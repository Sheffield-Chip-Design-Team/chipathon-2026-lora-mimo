+  logic [ADDR_WIDTH-1:0]      periph_ahb_s_if_HADDR;
+  logic [2:0]                 periph_ahb_s_if_HBURST;
+  logic                       periph_ahb_s_if_HMASTLOCK;
+  logic [3:0]                 periph_ahb_s_if_HPROT;
+  logic [2:0]                 periph_ahb_s_if_HSIZE;
+  logic [1:0]                 periph_ahb_s_if_HTRANS;
+  logic [DATA_WIDTH-1:0]      periph_ahb_s_if_HWDATA;
+  logic                       periph_ahb_s_if_HWRITE;
+  logic [DATA_WIDTH-1:0]      periph_ahb_s_if_HRDATA;
+  logic                       periph_ahb_s_if_HREADY;
+  logic                       periph_ahb_s_if_HRESP;
+
+  // Byproducts of reusing ahb_conn_buff here: periph_ss is the top of its own
+  // sub-fabric (no HSEL/HREADYIN ports of its own -- it treats itself as
+  // always selected), so these two buffer outputs have nothing to drive.
+  logic                       unused_periph_pipe_m_HSEL;
+  logic                       unused_periph_pipe_m_HREADYIN;
+
   // ROM Interface
   logic [ROM_ADDR_WIDTH-1:0]  rom_addr;
   logic                       rom_read;
@@ -155,6 +177,68 @@ module digital_ss #(
     .ram_rdata  (ram_rdata)
   );
 
+  // --- CPU -> Periph AHB pipeline register slice --------------------------------
+  //
+  // LOCAL INTEGRATION PATCH (not upstream). Added for the Grouper<->Trouper
+  // chip-top P&R: breaks the long combinational CPU -> interconnect_ss
+  // address-decode / request-fanout cone that is the sole grouper-side
+  // max_ss_125C_3v00 setup violator (HCLK16 path group, startpoint
+  // u_cpu_ss.u_cpu.latched_branch, ~-24 ns WNS pre-fix, ~250 fanout endpoints
+  // across every peripheral slot -- job 5117). Reuses ahb_conn_buff, the same
+  // register-slice module the fabric already uses, rather than a hand-written
+  // pipeline FSM.
+  //
+  // COST: ahb_conn_buff buffers BOTH request and response, so every
+  // peripheral (UART, GPIO, SPI M/S, QSPI, debug, and the external-periph /
+  // Grouper->Trouper bridge window) access takes 2 extra HCLK cycles
+  // (1-cycle transfer -> 3). RAM/ROM are NOT affected (dev wires them
+  // straight to the CPU, off this bus). picorv32 tolerates arbitrary wait
+  // states, so this is expected functionally safe, but the CPI cost is
+  // unmeasured and MUST be signed off by both the Grouper and Trouper teams
+  // -- see lora-mimo/integration/planning/Open Risks.md #1.
+  //
+  // Lint-clean; NOT simulated. Confirmed to remove the target violator in
+  // test P&R (jobs 4862, 5069-class recipe).
+
+  ahb_conn_buff #(
+    .ADDR_WIDTH (ADDR_WIDTH),
+    .DATA_WIDTH (DATA_WIDTH)
+  ) u_ahb_cpu_periph_pipe (
+    .hclk        (clk),
+    .hresetn     (rst_n),
+
+    // Upstream: the CPU is the sole master and there is no other bus segment
+    // sharing this port, so it is always selected / always able to accept.
+    .s_HADDR     (cpu_ss_ahb_s_if_HADDR),
+    .s_HBURST    (cpu_ss_ahb_s_if_HBURST),
+    .s_HMASTLOCK (cpu_ss_ahb_s_if_HMASTLOCK),
+    .s_HPROT     (cpu_ss_ahb_s_if_HPROT),
+    .s_HSIZE     (cpu_ss_ahb_s_if_HSIZE),
+    .s_HTRANS    (cpu_ss_ahb_s_if_HTRANS),
+    .s_HWDATA    (cpu_ss_ahb_s_if_HWDATA),
+    .s_HWRITE    (cpu_ss_ahb_s_if_HWRITE),
+    .s_HREADYIN  (1'b1),
+    .s_HSEL      (1'b1),
+    .s_HRDATA    (cpu_ss_ahb_s_if_HRDATA),
+    .s_HREADYOUT (cpu_ss_ahb_s_if_HREADY),
+    .s_HRESP     (cpu_ss_ahb_s_if_HRESP),
+
+    // Downstream: periph_ss (no HSEL/HREADYIN ports of its own).
+    .m_HADDR     (periph_ahb_s_if_HADDR),
+    .m_HBURST    (periph_ahb_s_if_HBURST),
+    .m_HMASTLOCK (periph_ahb_s_if_HMASTLOCK),
+    .m_HPROT     (periph_ahb_s_if_HPROT),
+    .m_HSIZE     (periph_ahb_s_if_HSIZE),
+    .m_HTRANS    (periph_ahb_s_if_HTRANS),
+    .m_HWDATA    (periph_ahb_s_if_HWDATA),
+    .m_HWRITE    (periph_ahb_s_if_HWRITE),
+    .m_HREADYIN  (unused_periph_pipe_m_HREADYIN),
+    .m_HSEL      (unused_periph_pipe_m_HSEL),
+    .m_HRDATA    (periph_ahb_s_if_HRDATA),
+    .m_HREADYOUT (periph_ahb_s_if_HREADY),
+    .m_HRESP     (periph_ahb_s_if_HRESP)
+  );
+
   // --- Peripheral Subsystem --------------------------------------------------------
   // Interconnect + AHBlite Peripheral blocks (UART, GPIO, SPI M/S, QSPI)
 
@@ -166,17 +250,19 @@ module digital_ss #(
     .HCLK                (clk),
     .HRESETn             (rst_n),
 
-    .HADDR               (cpu_ss_ahb_s_if_HADDR),
-    .HBURST              (cpu_ss_ahb_s_if_HBURST),
-    .HMASTLOCK           (cpu_ss_ahb_s_if_HMASTLOCK),
-    .HPROT               (cpu_ss_ahb_s_if_HPROT),
-    .HSIZE               (cpu_ss_ahb_s_if_HSIZE),
