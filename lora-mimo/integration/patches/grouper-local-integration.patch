+    .HTRANS              (periph_ahb_s_if_HTRANS),
+    .HWDATA              (periph_ahb_s_if_HWDATA),
+    .HWRITE              (periph_ahb_s_if_HWRITE),
+    .HRDATA              (periph_ahb_s_if_HRDATA),
+    .HREADY              (periph_ahb_s_if_HREADY),
+    .HRESP               (periph_ahb_s_if_HRESP),
 
     .uart_rx_irq         (uart_rx_irq),
     .uart_rx_error_irq   (uart_rx_error_irq),
