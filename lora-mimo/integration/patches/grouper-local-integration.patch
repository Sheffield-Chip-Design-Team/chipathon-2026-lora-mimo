-    .HWRITE              (cpu_ss_ahb_s_if_HWRITE),
-    .HRDATA              (cpu_ss_ahb_s_if_HRDATA),
-    .HREADY              (cpu_ss_ahb_s_if_HREADY),
-    .HRESP               (cpu_ss_ahb_s_if_HRESP),
+    // Fed from the pipeline register slice (u_ahb_cpu_periph_pipe), NOT
