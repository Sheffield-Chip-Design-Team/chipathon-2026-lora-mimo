diff --git a/hw/rtl/periph_ss.sv b/hw/rtl/periph_ss.sv
index 0c1fb70..7c7d5c9 100644
--- a/hw/rtl/periph_ss.sv
+++ b/hw/rtl/periph_ss.sv
@@ -579,8 +579,19 @@ logic [3:0] mux_qspi_sio_oe;  // internal signal for QSPI data output enable
   // The external port is deliberately narrower than the fabric slot
   // (EXT_ADDR_WIDTH / EXT_DATA_WIDTH, both 8 by default) to keep the wire
   // count out of the block down, so the address and write data are truncated
-  // and the read data zero-extended. Note the consequence: the slot decodes a
-  // 64 KiB window but an 8-bit address only reaches its first 256 bytes.
+  // and the read data replicated across every byte lane. Note the consequence:
+  // the slot decodes a 64 KiB window but an 8-bit address only reaches its
+  // first 256 bytes.
+  //
+  // LOCAL INTEGRATION PATCH (not upstream): read data is replicated across all
+  // DATA_WIDTH/EXT_DATA_WIDTH byte lanes rather than zero-extended into the
+  // low lane. picorv32 byte-extracts a load from HRDATA[8*addr[1:0] +: 8]
+  // (its addressed lane), so a low-lane-only value makes every non-word-
+  // aligned lbu from this window read 0 -- which breaks reading Trouper's
+  // byte-packed Z_kl / Z_kk / N_ACC registers. Replication (the same trick
+  // picorv32 uses on its own store path, mem_la_wdata = {4{rs2[7:0]}}) makes
+  // the lane select land on the byte for any address. See
+  // lora-mimo/integration/planning/grp-ext-periph-byte-lane.md.
   //
   // ext_periph_HSEL and ext_periph_HREADYIN have nowhere to go until the
   // bridge above exists - an external slave cannot tell it is selected
@@ -594,7 +605,7 @@ logic [3:0] mux_qspi_sio_oe;  // internal signal for QSPI data output enable
   assign ext_HTRANS    = ext_periph_HTRANS;
   assign ext_HWDATA    = ext_periph_HWDATA[EXT_DATA_WIDTH-1:0];
   assign ext_HWRITE    = ext_periph_HWRITE;
-  assign ext_periph_HRDATA    = {{(DATA_WIDTH-EXT_DATA_WIDTH){1'b0}}, ext_HRDATA};
+  assign ext_periph_HRDATA    = {(DATA_WIDTH/EXT_DATA_WIDTH){ext_HRDATA}};
   assign ext_periph_HREADYOUT = ext_HREADY;
   assign ext_periph_HRESP     = ext_HRESP;
 
